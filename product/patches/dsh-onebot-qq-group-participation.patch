+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {GroupParticipation,shouldJoinGroup} from '../lib/group-participation.js';
+import {createGroupAuthority} from '../lib/group-authority.js';
+const line=(groupId,text)=>({groupId,nickname:'test',text});
+test('coalesces a burst, respects silence, and a direct call supersedes an in-flight choice',async()=>{
+ const hold=setInterval(()=>{},1000);const seen=[];let resume,started;const running=new Promise(r=>started=r);
+ const gate=new GroupParticipation(async (lines,signal)=>{seen.push(lines);if(lines.at(-1).text==='slow'){started();await new Promise(r=>resume=r)}return lines.at(-1).text!=='ok';},{batchMs:1,intervalMs:1});
+ try {
+  const earlier=gate.consider(line('1','first'),false),later=gate.consider(line('1','help'),false);assert.equal(await earlier,null);assert.equal((await later).context[0].text,'first');assert.equal(seen.length,1);
+  assert.equal(await gate.consider(line('2','ok'),false),null);assert.equal(seen.at(-1).length,1);
+  const slow=gate.consider(line('1','slow'),false);await running;assert.deepEqual(gate.consider(line('1','Alcor'),true),{direct:true});assert.equal(await slow,null);resume();
+  const pending=gate.consider(line('1','pending'),false);gate.stop();assert.equal(await pending,null);
+ } finally {gate.stop();clearInterval(hold)}
+});
+test('only a complete positive model decision admits unsolicited participation',async()=>{
+ const ctx=chunks=>({llm:{async *stream(){yield* chunks}}});const route={provider:'demo',model:'demo'}, signal=new AbortController().signal;
+ for(const [chunks,want] of [[[{type:'text-delta',text:'JOIN'}],true],[[{type:'block-end',block:{type:'text',text:'PASS'}}],false],[[{type:'reasoning-delta',text:'JOIN'}],false],[[{type:'text-delta',text:'JOIN'},{type:'finish',reason:{kind:'error'}}],false]])assert.equal(await shouldJoinGroup(ctx(chunks),route,[],signal),want);
+});
+test('ambient context cannot lend a member the administrator’s local tools',()=>{
+ let turn=1;const a={session:{}},g=createGroupAuthority('1',()=>['10'],()=>({openTurnStartSeq:turn,lastTurn:turn}));const source={kind:'plugin:dsh-onebot',qqUserId:'10',qqGroupId:'1'};
+ g.observe(a,[{source:{...source,qqAmbient:true}}]);assert.equal(g.allowed(a,'bash'),false);assert.equal(g.allowed(a,'qq_group_remember'),true);g.observe(a,[{source}]);assert.equal(g.allowed(a,'bash'),false);turn++;g.observe(a,[{source}]);assert.equal(g.allowed(a,'bash'),true);
+});
