@@ -0,0 +1,41 @@
+export const GROUP_MEMORY_TOOLS = ['qq_group_remember', 'qq_group_recall'];
+export const GROUP_LOCAL_TOOLS = ['working_directory', 'bash', 'read', 'write', 'edit', 'apply_patch', 'read_image', 'glob', 'grep', 'job_output', 'job_list', 'job_kill'];
+
+/** Authority comes only from the bridge's producer-owned source, never message text. */
+export function createGroupAuthority(groupId, adminUsers, turnBoundaryOf) {
+    const turns = new WeakMap();
+    const current = agent => {
+        const saved = agent && turns.get(agent);
+        const boundary = agent?.session && turnBoundaryOf(agent.session);
+        return saved && saved.session === agent.session && saved.start === boundary?.openTurnStartSeq
+            && saved.turn === boundary?.lastTurn ? saved : undefined;
+    };
+    return {
+        observe(agent, messages) {
+            const boundary = agent?.session && turnBoundaryOf(agent.session);
+            if (!boundary || boundary.openTurnStartSeq == null || !Number.isSafeInteger(boundary.lastTurn) || boundary.lastTurn < 1) {
+                if (agent) turns.delete(agent);
+                return;
+            }
+            if (!messages.length) return;
+            const previous = current(agent);
+            const sources = messages.map(message => message.source);
+            const valid = sources.every(source => source?.kind === 'plugin:dsh-onebot'
+                && source.qqGroupId === groupId && typeof source.qqUserId === 'string' && /^[1-9]\d{0,19}$/.test(source.qqUserId));
+            turns.set(agent, {
+                session: agent.session, start: boundary.openTurnStartSeq, turn: boundary.lastTurn,
+                valid: valid && previous?.valid !== false,
+                users: [...new Set([...(previous?.users ?? []), ...sources.map(source => source?.qqUserId)])],
+            });
+        },
+        allowed(agent, name) {
+            const saved = current(agent);
+            if (!saved?.valid) return false;
+            if (GROUP_MEMORY_TOOLS.includes(name)) return true;
+            if (!GROUP_LOCAL_TOOLS.includes(name)) return false;
+            const whitelist = adminUsers();
+            return saved.users.length > 0 && saved.users.every(user => whitelist.includes(user));
+        },
+        guard(execution) { return this.allowed(execution.agent, execution.name) ? undefined : '本机工具仅限 QQ 管理员白名单，当前回合没有有效授权。'; },
+    };
+}
