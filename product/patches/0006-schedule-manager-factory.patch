diff --git a/packages/client/ui-schedule/src/client/manager-factory.tsx b/packages/client/ui-schedule/src/client/manager-factory.tsx
new file mode 100644
index 00000000..ef74f554
--- /dev/null
+++ b/packages/client/ui-schedule/src/client/manager-factory.tsx
@@ -0,0 +1,117 @@
+/** Shared native manager wiring; product views supply a scoped Remote, never another scheduler. */
+import { useMemo, useSyncExternalStore } from 'react'
+import type { Context } from '@deepseek-ai/cordis'
+import type { RemoteResult } from '@deepseek-ai/dsh-api-remotes/client'
+import type { PropsLocale, PropsRuntime, PropsRenderSlots } from '@deepseek-ai/dsh-client-ui-slots'
+import type { ScheduleCatalogEntry, ScheduleCreateRequest, ScheduleDeleteInactiveResult, ScheduleDeliveryHistoryRequest, ScheduleDeliveryHistoryResult, ScheduleEditRequest, ScheduleEditResult, ScheduleRunResult } from '@deepseek-ai/dsh-schedule/client'
+import { createCatalogSource } from './catalog-source.ts'
+import { createClearEnded, type ClearEndedOutcome } from './clear-ended.ts'
+import { TaskManagerPage, type TaskManagerInjected } from './TaskManagerPage.tsx'
+import type { TaskEditorStoreProps, createEditorStore } from './editor-store.ts'
+
+export interface ManagerRemote {
+  catalog: () => Promise<RemoteResult<ScheduleCatalogEntry[]>>
+  create: (request: ScheduleCreateRequest) => Promise<RemoteResult<ScheduleCatalogEntry>>
+  edit: (request: ScheduleEditRequest) => Promise<RemoteResult<ScheduleEditResult>>
+  run: (request: { id: ScheduleCatalogEntry['id'] }) => Promise<RemoteResult<ScheduleRunResult>>
+  history: (request: ScheduleDeliveryHistoryRequest) => Promise<RemoteResult<ScheduleDeliveryHistoryResult>>
+  deleteInactive: () => Promise<RemoteResult<ScheduleDeleteInactiveResult>>
+  deliveryLimits: () => Promise<RemoteResult<{ newSessionIntervalSeconds: number }>>
+}
+export interface ManagerTemplate {
+  readonly id: string
+  readonly label: string
+  readonly title: string
+  readonly prompt: string
+  readonly frequency: 'daily' | 'weekly'
+}
+export interface ManagerOptions {
+  readonly remote?: ManagerRemote
+  readonly onNewTask?: () => void
+  readonly templates?: readonly ManagerTemplate[]
+  readonly scopeLabel?: string
+  readonly manualCreation?: boolean
+}
+export function wireManager(ctx: Context, api: ManagerRemote, reportDelete: (outcome: 'deleted' | 'failed' | 'pending') => void,
+  reportClear: (outcome: ClearEndedOutcome) => void,
+  onOpenSession: TaskManagerInjected['onOpenSession'], onNewTask: () => void) {
+  const manager = createCatalogSource<ScheduleCatalogEntry>({
+    list: () => api.catalog(),
+    remove: async id => {
+      const result = await api.edit({ id, action: 'delete' })
+      if (!result.ok) return result
+      return { ok: true, value: 'deleted' in result.value ? { id, deleted: true } : { id, deleted: false, code: 'schedule_not_found' } }
+    },
+    subscribeChanged: listener => ctx.remote.$on('schedule/changed', listener),
+    subscribeReset: listener => ctx.on('connection/reset', listener),
+  })
+  const refresh = () => manager.onRetry(manager.hooks.catalog.getSnapshot().readRequest)
+  const clearEnded = createClearEnded({ removeInactive: () => api.deleteInactive(), refresh })
+  const correction = (result: { error: { code: string; details?: unknown } }): 'host.notFuture' | 'host.invalidRule' | undefined => {
+    if (result.error.code !== 'schedule/input-invalid') return undefined
+    const code = (result.error.details as { code?: string } | undefined)?.code
+    return code === 'not_future' ? 'host.notFuture' : ['invalid_rule', 'frequency_too_high', 'invalid_time_zone', 'time_out_of_range'].includes(code ?? '') ? 'host.invalidRule' : undefined
+  }
+  async function settle<T>(call: () => Promise<RemoteResult<T>>): Promise<RemoteResult<T> | undefined> {
+    try { return await call() } catch { return undefined }
+  }
+  const detail: TaskManagerInjected = {
+    hooks: manager.hooks,
+    onDelete: async id => { const outcome = await manager.onDelete(id); reportDelete(outcome); return outcome },
+    onRetry: manager.onRetry,
+    loadHistory: request => api.history(request),
+    onOpenSession,
+    hostActions: {
+      edit: async request => {
+        const result = await settle(() => api.edit(request))
+        if (!result) return { failed: 'host.saveError' }
+        if (!result.ok) return { failed: correction(result) ?? 'host.saveError' }
+        await refresh()
+        return !('code' in result.value) ? 'saved' : { failed: result.value.code === 'schedule_conflict' ? 'host.conflict' : 'detail.missing' }
+      },
+      run: async id => {
+        const result = await settle(() => api.run({ id }))
+        if (!result?.ok) return { failed: 'host.runError' }
+        await refresh()
+        return !('code' in result.value) ? 'queued' : { failed: result.value.code === 'schedule_execution_pending' ? 'host.executionPending' : 'detail.missing' }
+      },
+      loadNewSessionInterval: async () => { const result = await settle(() => api.deliveryLimits()); return result?.ok ? result.value.newSessionIntervalSeconds : undefined },
+    },
+    onNewTask,
+    onClearEnded: async () => { reportClear(await clearEnded()) },
+    onCreateTask: async request => {
+      const result = await settle(() => api.create(request))
+      if (!result) return { failed: 'host.createError' }
+      if (!result.ok) return { failed: correction(result) ?? 'host.createError' }
+      manager.retainCreated(result.value)
+      await refresh()
+      return { created: result.value }
+    },
+  }
+  return { manager, detail, refresh, clearEnded }
+}
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface SlotMap {
+    'schedule.manager.header': { kind: 'list'; scope: 'root'; owner: {} }
+  }
+  interface SlotFactoryMap {
+    'schedule.manager.view': {
+      scope: 'root'
+      props: ManagerOptions
+      children: { 'schedule.manager.header': { kind: 'list'; scope: 'root' } }
+      store: ReturnType<typeof createEditorStore>
+      inject: { wire: (remote?: ManagerRemote, onNewTask?: () => void) => ReturnType<typeof wireManager> }
+      locale: 'schedule.manager'
+    }
+  }
+}
+export function ScheduleManager(props: PropsRuntime<'main'> & PropsRenderSlots<'schedule.manager.header'> & PropsLocale<'schedule.manager'> & TaskEditorStoreProps & ManagerOptions & {
+  wire: (remote?: ManagerRemote, onNewTask?: () => void) => ReturnType<typeof wireManager>
+}) {
+  const { wire, remote, onNewTask } = props
+  const { manager, detail } = useMemo(() => wire(remote, onNewTask), [wire, remote, onNewTask])
+  const useCatalog: TaskManagerPagePropsCatalog = selector => selector(useSyncExternalStore(manager.hooks.catalog.subscribe, manager.hooks.catalog.getSnapshot))
+  return <TaskManagerPage {...props} {...detail} useCatalog={useCatalog} header={props.renderSlot('schedule.manager.header', {})} draftPrefix={remote ? props.scopeLabel ?? 'custom' : ''} />
