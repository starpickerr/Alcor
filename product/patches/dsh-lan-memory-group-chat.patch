+test('group paths and symbolic links cannot select another memory store', async t => {
+  const { root, create } = fixture(t)
+  assert.throws(() => create('../private'))
+  assert.throws(() => createGroupMemory({ groupId: '111111', dataRoot: 'relative' }))
+  const privateDir = join(root, 'private-store')
+  const groups = join(root, 'groups')
+  mkdirSync(privateDir)
+  mkdirSync(groups)
+  symlinkSync(privateDir, join(groups, '555555'))
+  assert.throws(() => create('555555'), /symbolic link/)
+  mkdirSync(join(groups, '666666'))
+  writeFileSync(join(privateDir, 'facts.jsonl'), 'PRIVATE_FILE_SENTINEL')
+  symlinkSync(join(privateDir, 'facts.jsonl'), join(groups, '666666', 'facts.jsonl'))
+  assert.throws(() => create('666666'), /symbolic link/)
+})
+
+test('shared memory injection and recall keep fixed byte budgets', t => {
+  const { create } = fixture(t)
+  const a = create('777777')
+  for (let i = 0; i < 8; i++) a.remember({ content: '共同关键字' + '熊'.repeat(290) + i })
+  assert.ok(Buffer.byteLength(a.contextText(), 'utf8') <= 4096)
+  const recalled = a.recall('共同关键字', 8)
+  assert.ok(recalled.length > 0)
+  assert.ok(recalled.reduce((total, item) => total + Buffer.byteLength(item.content, 'utf8'), 0) <= 2048)
+})
