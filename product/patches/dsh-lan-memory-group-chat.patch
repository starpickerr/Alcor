+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { createCapture } from '../lib/capture.js'
+
+function fixture(options = {}) {
+  const journal = []
+  const mood = []
+  const capture = createCapture({
+    store: {
+      appendJournal(record) { journal.push(record); return true },
+      recordMood(text, time, meta) { mood.push({ text, time, meta }) },
+    },
+    logger: { warn() { throw new Error('unexpected capture warning') } },
+    ...options,
+  })
+  return { capture, journal, mood }
+}
+
+function turn(capture, session, source = 'user', flushBeforeEnd = false) {
+  const id = session.id || session.sessionId
+  const events = [
+    { type: 'turn/start', data: { turn: 1 } },
+    { type: 'user/message', data: { source: { kind: source }, content: [{ type: 'text', text: 'Synthetic user text mentions onebot-group-untrusted-text.' }] } },
+    { type: 'assistant/message', data: { turn: 1, message: { source: { kind: 'model' }, content: [{ type: 'text', text: 'Synthetic answer. <mood>synthetic calm mood</mood>' }] } } },
+    { type: 'tool/call', data: { turn: 1, name: 'synthetic_tool' } },
+  ]
+  events.forEach((event, index) => capture.handleSessionEvent(session, { ...event, seq: index + 1, time: 1_800_000_000_000 + index }))
+  if (flushBeforeEnd) capture.flushSession(id, 1_800_000_000_010)
+  capture.handleSessionEvent(session, { type: 'turn/end', data: { turn: 1 }, seq: 5, time: 1_800_000_000_020 })
+  capture.flushSession(id, 1_800_000_000_030)
+  capture.flushAll()
+}
+
+for (const [name, session, source, flushBeforeEnd] of [
+  ['native group events and turn/end', { id: 'onebot-group-synthetic' }, 'user', false],
+  ['group sessionId fallback and explicit flushSession', { sessionId: 'onebot-group-synthetic-fallback' }, 'user-rpc', true],
+  ['QQ group source and mood', { id: 'onebot-group-synthetic-qq' }, 'plugin:dsh-onebot', true],
+]) {
+  test(name + ' never write personal capture state', () => {
+    const { capture, journal, mood } = fixture()
+    turn(capture, session, source, flushBeforeEnd)
+    assert.deepEqual({ journal, mood }, { journal: [], mood: [] })
+    assert.equal(capture.getStats().bufferedSessions, 0)
+    assert.equal(capture.getStats().lastError, null)
+  })
+}
+
+test('ordinary private user keeps journal, mood and tool capture', () => {
+  const { capture, journal, mood } = fixture()
+  turn(capture, { id: 'synthetic-private-session' }, 'user', true)
+  assert.equal(journal.length, 1)
+  assert.equal(journal[0].session, 'synthetic-private-session')
+  assert.deepEqual(journal[0].tools, ['synthetic_tool'])
+  assert.match(journal[0].user, /onebot-group-untrusted-text/)
+  assert.equal(mood.length, 1)
+  assert.equal(mood[0].text, 'synthetic calm mood')
+  assert.equal(capture.getStats().bufferedSessions, 0)
+  assert.equal(capture.getStats().lastError, null)
+})
+
+test('private QQ keeps its existing source filtering and mood capture', () => {
+  const { capture, journal, mood } = fixture()
+  turn(capture, { id: 'onebot-private-synthetic' }, 'plugin:dsh-onebot')
+  assert.deepEqual(journal, [])
+  assert.equal(mood.length, 1)
+  assert.equal(mood[0].meta.session, 'onebot-private-synthetic')
+  assert.equal(capture.getStats().userSources['plugin:dsh-onebot'], 1)
+  assert.equal(capture.getStats().bufferedSessions, 0)
+})
+
+test('explicit group capture accepts only its configured OneBot source', () => {
