+      const text = request.messages[0].content[0].text
+      prompts.push(text)
+      const updated = text.includes('new beta progress')
+      const result = text.includes('你是滚动记忆摘要器')
+        ? (updated ? 'memberA reports new beta progress.' : 'memberA prefers the shared alpha project.')
+        : text.includes('你是长期记忆抽取器')
+          ? (updated ? '[{"fact":"memberA reports new beta progress.","tags":["beta"],"time":null}]' : '[{"fact":"memberA prefers the shared alpha project.","tags":["alpha"],"time":null}]')
+          : '{"facts":"memberA prefers the shared alpha project.","today":"Group discussed alpha.","week":"Alpha discussion.","longterm":"memberA: alpha.","experience":[]}'
+      yield { type: 'text-delta', text: result }
+    },
+  }
+  const options = { llm, getDefaultModel: () => ({ provider: 'synthetic', model: 'synthetic' }) }
+  const a = create('333333', options)
+  for (let i = 1; i <= 6; i++) {
+    turn(a, '333333', i, `memberA: shared alpha update ${i}`)
+    if (i === 5) assert.equal(prompts.length, 0)
+  }
+  const result = await a.compilePending()
+  assert.equal(result.ok, true)
+  assert.equal(result.compiled, 6)
+  assert.equal(prompts.length, 3)
+  assert.ok(prompts.every(text => text.includes('本群共享记忆') && text.includes('发言人')))
+  assert.equal(a.status().pending, 0)
+  await a.compilePending()
+  assert.equal(prompts.length, 3)
+  await a.dispose()
+  const restored = create('333333', options)
+  assert.match(restored.contextText(), /memberA prefers/)
+  assert.equal(restored.status().pending, 0)
+  await restored.compilePending()
+  assert.equal(prompts.length, 3)
+  turn(restored, '333333', 7, 'memberA: new beta progress')
+  await restored.compilePending()
+  assert.equal(prompts.length, 6)
+  assert.doesNotMatch(prompts[3], /shared alpha update [1-6]/)
+  assert.match(prompts[3], /new beta progress/)
+})
+
+test('a model failure leaves group records pending for a later retry', async t => {
