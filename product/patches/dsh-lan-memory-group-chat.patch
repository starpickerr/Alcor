+  } finally {
+    store.releaseLock()
+    if (previousHome === undefined) delete process.env.DSH_HOME
+    else process.env.DSH_HOME = previousHome
+  }
+})
+
+test('compiler receives pending group records once and restores the checkpoint after restart', async t => {
