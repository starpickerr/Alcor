+test('new records received during compilation are scheduled after the batch settles', async t => {
+  const { create } = fixture(t)
+  const a = create('888888', {
+    llm: { async *stream(request) {
+      yield { type: 'text-delta', text: request.messages[0].content[0].text.includes('你是滚动记忆摘要器') ? 'Shared group discussion.' : '[]' }
+    } },
+    getDefaultModel: () => ({ provider: 'synthetic', model: 'synthetic' }),
+  })
+  for (let i = 1; i <= 7; i++) turn(a, '888888', i, `memberA: neutral alpha update ${i}`)
+  const result = await a.compilePending()
+  assert.equal(result.compiled, 6)
+  assert.equal(a.status().pending, 1)
+  assert.equal(a.status().scheduled, true)
+})
