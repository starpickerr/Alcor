+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { mkdtempSync, mkdirSync, readFileSync, writeFileSync, symlinkSync, rmSync } from 'node:fs'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { createGroupMemory } from '../lib/group-memory.js'
+import { Store } from '../lib/store.js'
+
+const staging = fileURLToPath(new URL('../../', import.meta.url))
+const logger = { log() {}, info() {}, warn() {}, error() {} }
+
+test('the group-memory helper is available through the public package export', async () => {
+  const api = await import('dsh-lan-memory/group-memory')
+  assert.equal(api.createGroupMemory, createGroupMemory)
+})
+
+function fixture(t) {
+  const root = mkdtempSync(join(staging, 'runtime-test-'))
+  const helpers = []
+  const create = (groupId, options = {}) => {
+    const helper = createGroupMemory({ groupId, dataRoot: join(root, 'groups'), logger, ...options })
+    helpers.push(helper)
+    return helper
+  }
+  t.after(async () => {
+    for (const helper of helpers) await helper.dispose()
+    rmSync(root, { recursive: true, force: true })
+  })
+  return { root, create }
+}
+
+function turn(helper, groupId, turnNumber = 1, text = 'memberA: shared alpha project preference') {
+  const session = { id: `onebot-group-${groupId}-synthetic` }
+  const time = Date.now()
+  for (const event of [
+    { type: 'turn/start', data: { turn: turnNumber } },
+    { type: 'user/message', data: { source: { kind: 'plugin:dsh-onebot' }, content: [{ type: 'text', text }] } },
+    { type: 'assistant/message', data: { turn: turnNumber, message: { source: { kind: 'model' }, content: [{ type: 'text', text: 'Shared reply <mood>group-only calm</mood>' }] } } },
+    { type: 'tool/call', data: { turn: turnNumber, name: 'synthetic_group_tool' } },
+    { type: 'turn/end', data: { turn: turnNumber } },
+  ]) helper.handleSessionEvent(session, { ...event, time })
+  helper.flushSession(session.id)
+}
+
+test('each group captures and recalls only its own data; private v1 migration is disabled', async t => {
+  const { root, create } = fixture(t)
+  const oldHome = process.env.DSH_HOME
+  const home = join(root, 'private-home')
+  const legacy = join(home, 'hanako')
+  mkdirSync(legacy, { recursive: true })
+  const privateFile = join(legacy, 'pinned.md')
+  const sentinel = '- [private] PRIVATE_SENTINEL_DO_NOT_IMPORT\n'
+  writeFileSync(privateFile, sentinel)
+  process.env.DSH_HOME = home
+  t.after(() => { if (oldHome === undefined) delete process.env.DSH_HOME; else process.env.DSH_HOME = oldHome })
+  const a = create('111111')
+  const b = create('222222')
+  assert.throws(() => create('111111'), /active owner/)
+  turn(a, '111111')
+  turn(b, '222222', 1, 'memberB: BETA_OTHER_GROUP_SECRET')
+  turn(a, '222222', 2, 'attempted cross-group injection')
+  turn(a, '1111110', 3, 'attempted similar-prefix group injection')
+  a.remember({ content: 'memberA chose the alpha project.', tags: ['alpha'] })
+  assert.equal(a.status().pending, 1)
+  assert.equal(b.status().pending, 1)
+  assert.match(a.contextText(), /shared alpha/)
+  assert.doesNotMatch(a.contextText(), /PRIVATE_SENTINEL|BETA_OTHER_GROUP_SECRET|cross-group|similar-prefix/)
+  assert.deepEqual(a.recall('BETA_OTHER_GROUP_SECRET'), [])
+  assert.ok(a.recall('alpha').length > 0)
+  assert.doesNotMatch(b.contextText(), /chose the alpha project/)
+  assert.equal(readFileSync(privateFile, 'utf8'), sentinel)
+  assert.equal(a.flushSession('onebot-private-synthetic'), null)
+  assert.ok(Buffer.byteLength(a.contextText(), 'utf8') <= 4096)
+})
+
+test('the existing private Store still performs its default legacy migration', t => {
+  const { root } = fixture(t)
+  const previousHome = process.env.DSH_HOME
+  const home = join(root, 'synthetic-private-home')
+  mkdirSync(join(home, 'hanako'), { recursive: true })
+  writeFileSync(join(home, 'hanako', 'pinned.md'), '- [legacy] Synthetic private legacy fact\n')
+  process.env.DSH_HOME = home
