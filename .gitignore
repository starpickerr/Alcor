# stella cli
dist/
build/
*.egg-info/
.stella.pid

# Desktop backend packaging: keep the source files (spec/requirements/script)
# tracked even though the generic build/ rule above ignores them, but never
# track the build outputs or local venv.
!desktop/build/
desktop/build/*
!desktop/build/stella-backend.spec
!desktop/build/requirements-desktop.txt
!desktop/build/build-backend.sh
!desktop/build/build-feishu-vendor.py

# Icon authoring scratch dir: intermediate assets used to produce the final
# icons. Only the finished icons under desktop/resources/ should be committed.
desktop/resources/.icon-work/

# Bundled ripgrep binary: platform-specific, never committed.
desktop/resources/bin/

.wrangler/
evals/reports/
# Native build output
packages/stella-apple-sync/python/apple_sync/StellaCalendarBridge
packages/stella-apple-sync/python/**/__pycache__/
packages/stella-secretary/business/**/__pycache__/

# Keep native Apple sync source despite the legacy python-directory ignore.
!/packages/stella-apple-sync/python/

/packages/stella-apple-sync/python/apple_sync/Stella Apple Sync.app/

# Alcor package paths (retain legacy patterns above for compatibility).
/packages/alcor-elearning/server/
/packages/alcor-mail/server/
/packages/alcor-privacy/native/keychain-bridge
packages/alcor-apple-sync/python/apple_sync/StellaCalendarBridge
packages/alcor-apple-sync/python/**/__pycache__/
packages/alcor-secretary/business/**/__pycache__/
!/packages/alcor-apple-sync/python/
/packages/alcor-apple-sync/python/apple_sync/Alcor Apple Sync.app/
/packages/alcor-secretary/native/Alcor Confirm.app/
