  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-primitives"]}},
  "dependencies": {"zod": "4.6.7"},
  "peerDependencies": {"@deepseek-ai/cordis": "*", "@deepseek-ai/dsh-typert-protocol": "*", "@deepseek-ai/dsh-atomic-write": "*", "@deepseek-ai/dsh-home-paths": "*", "react": "*"},
  "peerDependenciesMeta": {"@deepseek-ai/cordis": {"optional": true}, "@deepseek-ai/dsh-typert-protocol": {"optional": true}, "@deepseek-ai/dsh-atomic-write": {"optional": true}, "@deepseek-ai/dsh-home-paths": {"optional": true}, "react": {"optional": true}},
  "engines": {"node": ">=24.9.0", "dsh": "0.2.2-alpha.3 || 0.2.2-rc.1"}
}
